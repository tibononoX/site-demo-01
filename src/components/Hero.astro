---
import { getImage } from 'astro:assets';
import villa from '../assets/img/fv/villa-founex.jpg';
import Stroke from './Stroke.astro';
import { u, TEL, TEL_TXT } from '../lib';
const d = await getImage({ src: villa, width: 1000, format: 'webp', quality: 70 });
const d1 = await getImage({ src: villa, width: 660, format: 'webp', quality: 70 });
const m = await getImage({ src: villa, width: 780, height: 600, fit: 'cover', format: 'webp', quality: 65 });
const m1 = await getImage({ src: villa, width: 390, height: 300, fit: 'cover', format: 'webp', quality: 65 });
---
<section class="hero" aria-labelledby="h1">
  <div class="hero-img">
    <picture>
      <source media="(min-width:1024px)" srcset={`${d1.src} 660w, ${d.src} 1000w`} sizes="660px">
      <img class="ph" src={m1.src} srcset={`${m1.src} 390w, ${m.src} 780w`} sizes="100vw" alt="Murs et plafonds remis à neuf par FV Peinture dans une villa mitoyenne à Founex" width="390" height="300" fetchpriority="high">
    </picture>
    <Stroke class="pst p1" eager sizes="(min-width:1024px) 960px, 500px" /><Stroke class="pst p2" variant="small" sizes="(min-width:1024px) 420px, 300px" />
  </div>
  <div class="hero-txt">
    <span class="ey">Peinture · Plâtre · Cloisons · Sols · Façades</span>
    <h1 class="h" id="h1"><span>Peintre &amp;</span><span class="i">rénovation</span><span>à Genève.</span></h1>
    <p>Le savoir-faire en couleur. Rénovation et remise à neuf de vos biens immobiliers, pour les particuliers comme pour les professionnels.</p>
    <div class="ctas"><a class="btn btn-g" href={u('devis/')}>Demander un devis <span class="ar" aria-hidden="true">→</span></a><a class="btn btn-o" href={TEL}>{TEL_TXT}</a></div>
  </div>
</section>
<div class="trust"><span class="note"><span class="stars sm" aria-hidden="true">★★★★★</span> <b>5,0</b> sur Google</span><span class="pt">Genève &amp; arc lémanique</span><span class="pt">Un seul interlocuteur</span><span class="pt">Collaborateurs diplômés en Suisse</span><span class="pt">Matériaux suisses</span></div>
